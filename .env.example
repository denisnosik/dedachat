POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=messenger
SECRET=your_secret_here
DB_URL="postgres://postgres:postgres@db:5432/messenger?sslmode=disable"
GOOSE_DRIVER="postgres"
GOOSE_DBSTRING="postgres://postgres:postgres@db:5432/messenger?sslmode=disable"
GOOSE_MIGRATION_DIR="sql/schema"

# Optional. Rate limits, shown with their defaults; 0 disables a tier.
# The auth tier is per client IP, the api tier is per user.
# RATE_LIMIT_AUTH_PER_MIN=20
# RATE_LIMIT_AUTH_BURST=10
# RATE_LIMIT_API_PER_SEC=20
# RATE_LIMIT_API_BURST=40

# Optional. Set to true only when the server sits behind a proxy that rewrites
# X-Forwarded-For (Railway, nginx, a load balancer). Without it every request
# looks like it comes from the proxy and all clients share one IP bucket; with
# it on a directly exposed server, a client can spoof the header and get a
# fresh bucket per request.
# TRUST_PROXY_HEADERS=false
